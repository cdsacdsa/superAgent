{
  "mcpServers": {
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@4.0.0-beta.6", "server", "start",
               "--namespace", "group", "--namespace", "subscription",
               "--namespace", "containerapps", "--namespace", "cosmos",
               "--namespace", "servicebus", "--namespace", "keyvault",
               "--namespace", "monitor", "--namespace", "deploy",
               "--namespace", "bicepschema", "--namespace", "extension"],
      "env": {
        "AZURE_TOKEN_CREDENTIALS": "EnvironmentCredential",
        "AZURE_MCP_COLLECT_TELEMETRY": "false"
      }
    }
  }
}
