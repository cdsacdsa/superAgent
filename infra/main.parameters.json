    "fastReasoningEffort": { "value": "${SA_FAST_REASONING_EFFORT=}" },
    "foundryFastModelFormat": { "value": "${SA_FOUNDRY_FAST_FORMAT=OpenAI}" },
    "foundryFastModelVersion": { "value": "${SA_FOUNDRY_FAST_VERSION=}" },
    "foundryFastSku": { "value": "${SA_FOUNDRY_FAST_SKU=GlobalStandard}" },
    "foundryFastCapacity": { "value": "${SA_FOUNDRY_FAST_CAPACITY=50}" },
    "foundryExpertModel": { "value": "${SA_FOUNDRY_EXPERT_MODEL=claude-opus-5-5}" },
    "foundryExpertModelFormat": { "value": "${SA_FOUNDRY_EXPERT_FORMAT=Anthropic}" },
    "foundryExpertModelVersion": { "value": "${SA_FOUNDRY_EXPERT_VERSION=}" },
    "foundryExpertSku": { "value": "${SA_FOUNDRY_EXPERT_SKU=GlobalStandard}" },
    "foundryExpertCapacity": { "value": "${SA_FOUNDRY_EXPERT_CAPACITY=10}" },
    "claudeOrganizationName": { "value": "${SA_CLAUDE_ORGANIZATION_NAME=}" },
    "claudeCountryCode": { "value": "${SA_CLAUDE_COUNTRY_CODE=}" },
    "claudeIndustry": { "value": "${SA_CLAUDE_INDUSTRY=}" },
    "searchSku": { "value": "${SA_SEARCH_SKU=free}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "productSandboxImage": { "value": "${SA_PRODUCT_SANDBOX_IMAGE=}" },
    "productBootstrapDir": { "value": "${SA_PRODUCT_BOOTSTRAP_DIR=}" },
    "atlassianBaseUrl": { "value": "${SA_ATLASSIAN_BASE_URL=}" },
    "atlassianUser": { "value": "${SA_ATLASSIAN_USER=}" },
    "confluenceEnabled": { "value": "${SA_CONFLUENCE_ENABLED=false}" },
    "confluenceSpaces": { "value": "${SA_CONFLUENCE_SPACES=}" },
    "jiraKbEnabled": { "value": "${SA_JIRA_KB_ENABLED=false}" },
    "jiraKbProjects": { "value": "${SA_JIRA_KB_PROJECTS=}" },
    "vmInstallerBlobUrl": { "value": "${SA_VM_INSTALLER_BLOB_URL=}" },
    "vmSetupScript": { "value": "${SA_VM_SETUP_SCRIPT=}" },
    "apiImage": { "value": "${SERVICE_API_IMAGE_NAME=}" },
    "workerImage": { "value": "${SERVICE_WORKER_IMAGE_NAME=}" },
    "atlassianApiToken": { "value": "${SA_ATLASSIAN_API_TOKEN=}" },
    "mcpToken": { "value": "${SA_MCP_TOKEN=}" },
    "fastApiKey": { "value": "${SA_FAST_API_KEY=}" },
    "expertApiKey": { "value": "${SA_EXPERT_API_KEY=}" },
    "servicenowPassword": { "value": "${SA_SERVICENOW_PASSWORD=}" },
    "jiraApiToken": { "value": "${SA_JIRA_API_TOKEN=}" },
    "teamsWebhookUrl": { "value": "${SA_TEAMS_WEBHOOK_URL=}" },
    "slackWebhookUrl": { "value": "${SA_SLACK_WEBHOOK_URL=}" },
    "ragApiKey": { "value": "${SA_RAG_API_KEY=}" },
    "webhookSecret": { "value": "${SA_WEBHOOK_SECRET=}" },
    "consoleApiKey": { "value": "${SA_CONSOLE_API_KEY=}" },
    "entraClientSecret": { "value": "${SA_ENTRA_CLIENT_SECRET=}" }
