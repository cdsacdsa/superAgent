{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "itsmProvider": { "value": "${SA_ITSM_PROVIDER=mock}" },
    "chatProvider": { "value": "${SA_CHAT_PROVIDER=console}" },
    "fastBaseUrl": { "value": "${SA_FAST_BASE_URL=https://openrouter.ai/api/v1}" },
    "fastModel": { "value": "${SA_FAST_MODEL=deepseek/deepseek-v4.1-flash}" },
    "expertProvider": { "value": "${SA_EXPERT_PROVIDER=anthropic}" },
    "expertModel": { "value": "${SA_EXPERT_MODEL=claude-opus-5-5}" },
    "foundryResource": { "value": "${SA_FOUNDRY_RESOURCE=}" },
    "servicenowInstance": { "value": "${SA_SERVICENOW_INSTANCE=}" },
    "servicenowUser": { "value": "${SA_SERVICENOW_USER=}" },
    "jiraBaseUrl": { "value": "${SA_JIRA_BASE_URL=}" },
    "jiraUser": { "value": "${SA_JIRA_USER=}" },
    "jiraProjectKey": { "value": "${SA_JIRA_PROJECT_KEY=}" },
    "ragApiUrl": { "value": "${SA_RAG_API_URL=}" },
    "enableVmSandbox": { "value": "${SA_ENABLE_VM_SANDBOX=false}" },
    "enableSearch": { "value": "${SA_ENABLE_SEARCH=false}" },
    "entraClientId": { "value": "${SA_ENTRA_CLIENT_ID=}" },
    "fastApiKey": { "value": "${SA_FAST_API_KEY=}" },
    "expertApiKey": { "value": "${SA_EXPERT_API_KEY=}" },
    "servicenowPassword": { "value": "${SA_SERVICENOW_PASSWORD=}" },
    "jiraApiToken": { "value": "${SA_JIRA_API_TOKEN=}" },
    "teamsWebhookUrl": { "value": "${SA_TEAMS_WEBHOOK_URL=}" },
    "slackWebhookUrl": { "value": "${SA_SLACK_WEBHOOK_URL=}" },
    "ragApiKey": { "value": "${SA_RAG_API_KEY=}" },
    "webhookSecret": { "value": "${SA_WEBHOOK_SECRET=}" },
    "consoleApiKey": { "value": "${SA_CONSOLE_API_KEY=}" },
    "entraClientSecret": { "value": "${SA_ENTRA_CLIENT_SECRET=}" }
  }
}
