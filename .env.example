# Copy to .env for local runs:  cp .env.example .env
SA_ENVIRONMENT=local
SA_RUN_WORKER_INPROC=true

# Fast tier: DeepSeek V4.1 Flash via OpenRouter (or https://api.deepseek.com with model deepseek-chat,
# or an Azure AI Foundry OpenAI-compatible endpoint)
SA_FAST_PROVIDER=openai_compat
SA_FAST_BASE_URL=https://openrouter.ai/api/v1
SA_FAST_MODEL=deepseek/deepseek-v4.1-flash
SA_FAST_API_KEY=

# Expert tier: Claude Opus 5.5 (Claude API). For Microsoft Foundry: SA_EXPERT_PROVIDER=foundry + SA_FOUNDRY_RESOURCE
SA_EXPERT_PROVIDER=anthropic
SA_EXPERT_MODEL=claude-opus-5-5
SA_EXPERT_API_KEY=

# Offline demo without any keys: set both providers to "fake"
# SA_FAST_PROVIDER=fake
# SA_EXPERT_PROVIDER=fake

SA_ITSM_PROVIDER=mock          # mock | servicenow | jira
SA_SANDBOX_PROVIDER=mock       # mock | docker | aca_sessions | disabled
SA_CHAT_PROVIDER=console       # console | teams | slack
SA_STORE_PROVIDER=sqlite
SA_QUEUE_PROVIDER=memory

# ServiceNow
# SA_SERVICENOW_INSTANCE=contoso.service-now.com
# SA_SERVICENOW_USER=svc_superagent
# SA_SERVICENOW_PASSWORD=

# Knowledge
# SA_RAG_API_URL=https://rag.contoso.com/api/search
# SA_RAG_API_KEY=
# SA_SHAREPOINT_ENABLED=true
# SA_GRAPH_TENANT_ID= / SA_GRAPH_CLIENT_ID= / SA_GRAPH_CLIENT_SECRET=

